	(text "R80/C48 delay ON: it reaches the\n0.35-1 V threshold 3.4-10.7 ms\nafter VBUS (530k pull-down,\nTPS22919 p.4-5). With tON 1.75 ms\n(p.5), VCC33 comes > 2 ms after\nVDD5 (HD3SS3220 p.8). C48 also\nkeeps plug-in ringing off the\n6 V ON pin (p.4)"
		(exclude_from_sim no)
		(at 17.02 184.15 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "7b324480-8367-4d1e-a901-a7a87299ac69")
	)
	(text "If VBUS on, forward 3.3V to 3.3V_HD3"
		(exclude_from_sim no)
		(at 50.546 150.876 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
				(color 194 0 122 1)
			)
		)
		(uuid "86479c1b-5ff2-4fc2-8932-b2c9b58a71c3")
	)
	(text "VCONN_FAULT_N is not used in UFP mode"
		(exclude_from_sim no)
		(at 229.616 63.246 0)
		(effects
			(font
				(size 0.5 0.5)
				(thickness 0.254)
				(bold yes)
				(color 194 0 122 1)
			)
			(justify left)
		)
		(uuid "8784aaac-1a7a-4308-bc80-009de7da3f93")
	)
	(text "Datasheet Page 17:\nWhen using the 3.3V supply for I2C pull-up,\nthe customer must ensure that the VDD5 is 3V and above.\nOtherwise, the I2C may back power the device."
		(exclude_from_sim no)
		(at 92.456 151.892 0)
		(effects
			(font
				(size 1.1 1.1)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "88a5202b-12d1-47a8-a1c6-7bd817d37e8f")
	)
	(text "*I dont want a Buck-Boost just to power this 5V input.\nSo I am using VBUS, since I dont need to communicate with the HD3 anyways when no cable is present."
		(exclude_from_sim no)
		(at 17.272 162.306 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "8dfbb2b6-080a-4fdb-8cea-9cee8aae86ba")
	)
	(text "SS: FX5 TX (AC caps C14/C15) to TXP/TXN,\nFX5 RX to RXP/RXN (HD3SS3220 p.3)"
		(exclude_from_sim no)
		(at 184.15 132.08 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "a06a25c9-8f08-4797-9aed-7f37dadb0f67")
	)
	(text "R44 4.7K: PORT low must stay < 0.4 V\nagainst the pin bias (HD3SS3220 p.5/p.7)"
		(exclude_from_sim no)
		(at 259.08 106.68 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "a32edaf0-03a5-41fd-b14f-8273821bbf94")
	)
	(text "C14/C15 (EZ-USB sheet) are the only TX AC caps\n(75-200 nF, HD3SS3220 p.27); a second set\nwould halve it and float the mux DC bias"
		(exclude_from_sim no)
		(at 139.446 107.188 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "a53bcb21-91b5-45bb-bb61-4cb48425b3ee")
	)

	)
	(text "ADDR open = GPIO mode, no I2C (HD3SS3220 p.4)\nAs a UFP, pins 25/26 are open-drain outputs\nthat show the host's Type-C current:\nOUT1 low = 1.5 A or 3 A, OUT2 low = 3 A,\nboth high = default. R50/R51 pull them to\n+3.3V_HD3, so the levels are only valid\nwhile USB \"Data\" has VBUS"
		(exclude_from_sim no)
		(at 92.456 161.29 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 0 130 50 1)
			)
			(justify left top)
		)
		(uuid "faa98b2a-a8e9-4a8c-8808-edffe2ff5b90")
	)

	(text "C14/C15 in 0402: TI allows up to 0603 on SuperSpeed lines,\n0402 or smaller strongly recommended; place the pair\nsymmetrically (HD3SS3220 p.36)"
		(exclude_from_sim no)
		(at 139.446 118.11 0)

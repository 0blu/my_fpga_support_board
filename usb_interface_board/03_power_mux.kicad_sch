		(uuid "47bdef9b-8c4b-4db8-8754-ebb9602fc458")
	)
	(text "C42-C44: bypass caps on IN1, IN2 and OUT, close to IC2 (TPS2121 p.33). C43 gives the Data port its 1-10 uF on VBUS,\nC40 (USB Port \"Power\") the Power port. U8 keeps VBUS at 12 V max; C42/C44 stay 50 V parts for margin"
		(exclude_from_sim no)
		(at 119.38 50.8 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "52bc8905-40e9-42bc-b31f-81420f5159fa")
	)
	(text "R11 100k / R12 23.2k / R78 10k:\nPR1 = 0.25 x USB_POWER_12V, below\n5.5 V up to 20 V (p.6), USB \"Power\"\nstill wins above 4.3 V. OV1 = 0.075 x:\nIN1 opens above ~14 V (13.2-14.9 V,\nVREF p.8, OVP p.14)"
		(exclude_from_sim no)
		(at 19.05 78.74 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left top)
		)
		(uuid "66ca1ddb-f20e-4d0b-b619-893c690211d2")
	)
	(text "ILIM = (65.2)/(r^0.861)\n3.2 = (65.2)/(33.2^0.861)\n"
		(exclude_from_sim no)
		(at 76.708 78.74 0)
		(effects
			(font
				(size 0.5 0.5)
				(color 0 130 50 1)
			)
			(justify left bottom)
		)
		(uuid "7c4ed1f7-0255-4000-9dc6-ad18a7313ace")
	)
	(text "Prioritizes USB \"Power\", no matter the voltage"

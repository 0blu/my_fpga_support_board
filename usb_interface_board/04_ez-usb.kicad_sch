	)
	(text "For applications where a GPIO pin is used to select which input passes to the output,\nthe GPIO pin can be directly connected to the PR1 pin when MODE is tied high (≥ 1 V).\nWhen the GPIO is pulled high, VIN1 is used.\nWhen the GPIO pin is pulled low, VIN2 is used.\n"
		(exclude_from_sim no)
		(at 166.878 243.332 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 130 50 1)
			)
			(justify left bottom)
		)
		(uuid "d9030b0b-713a-4d90-8a0b-ff58274e4bf6")
	)
	(text "U6 decoupling: one 100 nF per ball group named under the cap, on the bottom side under the BGA next to those balls' vias.\n4.7 uF bulk per rail and IC4's 1 uF inputs next to the package"

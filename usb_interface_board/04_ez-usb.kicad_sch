	(text "VIN1 +3.3V, VIN2 and MODE +1.8V: PR1 high selects VIN1 (TPS2117 p.13), so REQUIRES_3.3V_IO_VOLTAGE\nhigh gives 3.3 V as noted at J3. MODE only needs >= 1 V (p.6)"
		(exclude_from_sim no)
		(at 114.3 279.4 0)

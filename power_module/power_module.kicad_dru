(version 1)

# INA4230 (U2) is a 0.4 mm pitch WCSP: the inner VS/EN/A0/A1 balls (+3.3V) escape diagonally
# between two outer balls, which needs a 0.1 mm track and 0.12 mm clearance inside its courtyard.
(rule "U2 WCSP fanout clearance"
	(condition "A.intersectsCourtyard('U2') && B.intersectsCourtyard('U2')")
	(constraint clearance (min 0.12mm)))

(rule "U2 WCSP fanout track"
	(condition "A.Type == 'Track' && A.intersectsCourtyard('U2')")
	(constraint track_width (min 0.1mm)))

# NT1 (RSN net tie) sits on B.Cu between C75 and C76, at the end of the RSN trace that runs paired with the
# RSP (DYN_V) sense trace to C75 pad 1. Its GND pad joins the B.Cu pour, which carries almost no current there:
# DC sim (2026-11-24, 11 A DYN_V return) puts it 11 uV from C75's GND via and 44 uV from C75's GND pad.
# It has no height, so the parent board's tall-component keepout does not apply to its two pads.
(rule "NT1 net tie in parent keepout"
	(severity ignore)
	(condition "A.memberOfFootprint('NT1') && A.insideArea('Very tall components of parent')")
	(constraint disallow pad))

	)
	(text "Convert 4.5V-12V to fixed 1.8V"
		(exclude_from_sim no)
		(at 13.97 16.256 0)
		(effects
			(font
				(size 5 5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6a418657-7d39-40ff-9e4e-1cb0fd4aa2ec")
	)
	(text "C44 22uF 0805 10V (~15uF at 1.8V, C43 removed) -> fsw/fLC ~37 (1uH, 1.5MHz, Eq.19 p.24): below the ~45\nthe 2pF ramp needs at 1.8V, inside the 1pF range (Fig. 8-3 p.24). FPGA-side caps raise the ratio; 1pF keeps more margin."
		(exclude_from_sim no)
		(at 168.91 73.66 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left)
		)
		(uuid "6f14e7c7-366a-43ae-a221-0d1d98fda4cc")
	)

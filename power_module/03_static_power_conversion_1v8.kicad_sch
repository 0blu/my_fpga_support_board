	(text "C35 CFF 20pF (Eq.20 p.24: ~16pF for RFBT 26.1k, 1.5MHz)\nWEBENCH with board parts (L3 1uH, C44 ~15uF):\nPM 68°, fc 126kHz, GM -44dB; bench-tune"
		(exclude_from_sim no)
		(at 170.18 124.46 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 210 0 0 1)
			)
			(justify left)
		)
		(uuid "525ca6c8-7ffa-472f-9ad4-894634ce915b")
	)

	(text "47.5k = 16.5A typ PEAK inductor current (14.78-18.48A, p.7)\ncycle-by-cycle peak limit (p.19): DC load = peak - ripple/2 -> no trip up to ~12A guaranteed, ~14.6A typ"
		(exclude_from_sim no)
		(at 183.388 112.522 0)
		(effects

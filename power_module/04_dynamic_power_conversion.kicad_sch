		(uuid "a124f724-d7a8-4846-b623-3e3cde68a5aa")
	)
	(text "C75-C77 3x100uF (~225uF eff at 1V) + L2 220nH -> fLC ~23kHz, inside the COMP3 window 9.0-37.1kHz (TPS542A50 p.17, Table 7-3).\nFPGA-side caps add to this: keep them below CIN (TPS22959 p.15) and the DYN_V total < ~1.4mF (fLC >= 9kHz)."
		(exclude_from_sim no)
		(at 167.64 54.61 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left)
		)
		(uuid "b603dd88-224f-4164-a864-701b50b43c32")
	)
	(text "The TPS542A50 output voltage can be adjusted in ~0.028% increments from -20% to +10% of the set output"
		(exclude_from_sim no)
		(at 69.85 149.86 0)
		(effects

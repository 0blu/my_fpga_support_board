	(text "C1: >=25V (12V input + hot-plug ringing; TPS542A50 PVIN abs max 20V, p.4).\n100uF in 5x5.4mm is only available up to ~16V -> 47uF/25V in 6.3x5.4mm (same height)"
		(exclude_from_sim no)
		(at 97.79 133.35 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left)
		)
		(uuid "cce637fd-784c-45f0-9362-243b548156b8")
	)
	(text "Power Module"
		(exclude_from_sim no)
		(at 13.716 15.494 0)
		(effects
			(font
				(size 5 5)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cfd6d2ce-18b4-472c-bbf4-7df8a0efaa32")
	)
	(text "We are switching the DYN_V voltage seperatedly,\nbecause the TPS542A50 can only regulate its power down to 0.8V while its enabled.\nSo we dont want to send potenially unwanted voltage to the FPGA."
		(exclude_from_sim no)
		(at 230.632 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 194 0 122 1)
			)
		)
		(uuid "f182129e-b2aa-4339-9d0e-74ff9c253d9f")
	)

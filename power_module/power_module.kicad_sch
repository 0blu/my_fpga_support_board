	(text "Power pins grouped per rail on the even row: +3.3V 32/34/36, +1.8V 26/28/30 (fed on B.Cu from the shunts, no vias),\nDYN_V_EXT 2-16 (this row faces J3 on the interface board). DC sim of both boards at full load:\n<= 2.20 A/pin (+3.3V, +1.8V at 6.6 A), <= 1.57 A/pin (DYN_V_EXT at 12 A), GND <= 1.3 A/pin"
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 0.8 0.8)
				(color 194 0 122 1)
			)
			(justify left bottom)
		)
		(uuid "325313cd-8564-4e16-b8ce-c78d5632bf85")
	)
	(text "2.2 Amp per pin"
		(exclude_from_sim no)
		(at 27.432 131.064 0)
